{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overlook",
  "version": "2.0.0",
  "identifier": "app.overlook.desktop",
  "build": {
    "beforeDevCommand": "node scripts/build-helper.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-helper.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Overlook",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 540,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0A0A0B"
      },
      {
        "label": "tray",
        "url": "index.html#tray",
        "width": 320,
        "height": 420,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "focus": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Per-network data usage tracker",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0" },
    "linux": { "deb": { "depends": ["iw"] } }
  }
}
